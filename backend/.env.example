# Example environment variables for development. Replace placeholders before use.

# Database (Postgres)
DB_HOST=your_db_host
DB_PORT=your_db_port
DB_USERNAME=name_of_your_db_user
DB_PASSWORD=YOUR_DB_PASSWORD
DB_DATABASE=name_of_your_db

# JWT authentication
# Keep this secret in production; rotate periodically.
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=your_jwt_expiration_time (e.g., 15m, 1h)

# Application
PORT=your_app_port (e.g., 3000)
NODE_ENV=your_node_environment (e.g., development, production)
FRONTEND_URL=your_frontend_url (e.g., http://localhost:4200)
